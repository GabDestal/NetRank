<mxfile host="app.diagrams.net"><diagram id="netrank-schema" name="NetRank schema"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="player" value='&lt;div style="text-align:center;font-size:14px;"&gt;&lt;b&gt;Player&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;id&lt;/u&gt;: Long&lt;br&gt;name: String&lt;br&gt;firstName, lastName: String&lt;br&gt;dob: Date&lt;br&gt;ioc: String&lt;br&gt;hand: String&lt;br&gt;height: Double&lt;br&gt;wikidataId: String&lt;br&gt;&lt;br&gt;&lt;i&gt;Style features (career)&lt;/i&gt;&lt;br&gt;acePct, doubleFaultPct&lt;br&gt;firstServeInPct, firstServeWonPct&lt;br&gt;secondServeWonPct, returnPointsWonPct&lt;br&gt;breakPointsSavedPct, breakPointsConvertedPct&lt;br&gt;hardWinShare, clayWinShare, grassWinShare&lt;br&gt;styleMatches: Long&lt;br&gt;&lt;br&gt;&lt;i&gt;Written by GDS&lt;/i&gt;&lt;br&gt;&lt;font color="#666666"&gt;prestige: Double, prestigeRank: Long&lt;/font&gt;&lt;br&gt;&lt;font color="#666666"&gt;styleId: Long, styleVector: Double[]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;fillColor=#F9C6C9;strokeColor=#C9777E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="320" height="450" as="geometry"/></mxCell><mxCell id="match" value='&lt;div style="text-align:center;font-size:14px;"&gt;&lt;b&gt;Match&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;id&lt;/u&gt;: String&lt;br&gt;matchId: String&lt;br&gt;date: Date&lt;br&gt;surface: String&lt;br&gt;round: String&lt;br&gt;bestOf: Long&lt;br&gt;score: String&lt;br&gt;minutes: Double&lt;br&gt;retired, walkover: Boolean&lt;br&gt;&lt;br&gt;&lt;i&gt;Odds linkage&lt;/i&gt;&lt;br&gt;oddsLinkMethod, oddsSourceRow: String&lt;br&gt;oddsDayOffset: Long&lt;br&gt;&lt;br&gt;&lt;i&gt;Market odds&lt;/i&gt;&lt;br&gt;marketMaxWinnerOdds, marketAvgWinnerOdds&lt;br&gt;marketMaxLoserOdds, marketAvgLoserOdds' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;fillColor=#BFE3F4;strokeColor=#4A9CC4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="220" width="310" height="360" as="geometry"/></mxCell><mxCell id="tournament" value='&lt;div style="text-align:center;font-size:14px;"&gt;&lt;b&gt;Tournament&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;id&lt;/u&gt;: String&lt;br&gt;name: String&lt;br&gt;year: Long&lt;br&gt;startDate: Date&lt;br&gt;surface: String&lt;br&gt;level, levelName: String&lt;br&gt;drawSize: Long' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;fillColor=#F7DDA9;strokeColor=#C99A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="250" width="250" height="200" as="geometry"/></mxCell><mxCell id="bookmaker" value='&lt;div style="text-align:center;font-size:14px;"&gt;&lt;b&gt;Bookmaker&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;name&lt;/u&gt;: String&lt;br&gt;code: String' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;fillColor=#D3E6F0;strokeColor=#6C9CB5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="20" width="250" height="90" as="geometry"/></mxCell><mxCell id="won" value="WON {stats}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="player" target="match"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="lost" value="LOST {stats}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="player" target="match"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="priced" value="PRICED {winnerOdds, loserOdds, overround}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bookmaker" target="match"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="partof" value="PART_OF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="match" target="tournament"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="beat" value="BEAT {wins, firstWin, lastWin}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.93;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="player" target="player"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="316" y="710"/><mxPoint x="440" y="710"/><mxPoint x="440" y="618.5"/></Array><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="similar" value="SIMILAR_STYLE {score}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0;exitY=0.93;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="player" target="player"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="618.5"/><mxPoint x="20" y="710"/><mxPoint x="124" y="710"/></Array><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="stats" value="&lt;b&gt;{stats} on WON and LOST&lt;/b&gt;&lt;br&gt;Per-player stats for that match:&lt;br&gt;aces, doubleFaults, servePoints, firstServesIn, firstServeWon, secondServeWon, serviceGames, breakPointsSaved, breakPointsFaced, rank, rankPoints, seed, entry, age" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;shape=note;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#999999;spacing=8;size=14;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="220" height="170" as="geometry"/></mxCell><mxCell id="legend" value='&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;u&gt;underlined&lt;/u&gt; = unique constraint (Player.id, Match.id, Tournament.id, Bookmaker.name) &amp;nbsp;·&amp;nbsp; Range indexes: Match.date, Player.name &amp;nbsp;·&amp;nbsp; Full-text index: player names (accent- and case-insensitive)&lt;br&gt;Dashed arrows = derived: BEAT is rebuilt from matches at each ingest; SIMILAR_STYLE is written by GDS KNN &amp;nbsp;·&amp;nbsp; &lt;font color="#666666"&gt;grey properties&lt;/font&gt; = written by GDS (PageRank, Louvain, KNN)' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#FAFAFA;strokeColor=#CCCCCC;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="1310" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>