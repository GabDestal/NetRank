        <mxCell id="c87" value="remap_log &lt;i&gt;(D2)&lt;/i&gt;, parameters &lt;i&gt;(analytics)&lt;/i&gt;" vertex="1" parent="c83" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;">
          <mxGeometry x="0" y="100" width="300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c88" value="&lt;b style='font-size:13px'&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style='padding-left:60px'&gt;&amp;nbsp;&lt;/span&gt;verified link (ATT&amp;amp;CK, KEV, NVD, CTID)&lt;br&gt;&lt;span style='padding-left:60px'&gt;&amp;nbsp;&lt;/span&gt;LLM-inferred link: separate type, never in verified queries (D12)&lt;br&gt;&lt;u&gt;&lt;b&gt;key&lt;/b&gt;&lt;/u&gt; &lt;font color='#B85450'&gt;&lt;b&gt;UNIQUE&lt;/b&gt;&lt;/font&gt;: uniqueness constraint, backed by an index&lt;br&gt;&lt;font color='#B85450'&gt;&lt;b&gt;RANGE INDEX&lt;/b&gt;&lt;/font&gt;: range index for filtering and sorting&lt;br&gt;(n): live node count measured 2026-10-15&lt;br&gt;&lt;span style='background:#DAE8FC'&gt;&amp;nbsp;blue&amp;nbsp;&lt;/span&gt; ATT&amp;amp;CK &amp;nbsp; &lt;span style='background:#FFE6CC'&gt;&amp;nbsp;orange&amp;nbsp;&lt;/span&gt; KEV / NVD &amp;nbsp; &lt;span style='background:#F5F5F5'&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; import metadata" vertex="1" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;">
          <mxGeometry x="350" y="1000" width="520" height="118" as="geometry" />
        </mxCell>
        <mxCell id="c89" value="&lt;b style='font-size:13px'&gt;Constraints, indexes and rules&lt;/b&gt;&lt;br&gt;• Uniqueness on &lt;b&gt;stix_id&lt;/b&gt; and &lt;b&gt;attack_id&lt;/b&gt; for :Group, :Campaign, :Software, :Technique, :Tactic, :Mitigation. :Software covers :Malware and :Tool; :Technique covers :SubTechnique (D1, D3, D5).&lt;br&gt;• Uniqueness on :CVE(cve_id), :CWE(cwe_id), :Product(product_key), :Vendor(vendor_key), :ImportMeta(source).&lt;br&gt;• Range index on :CVE(cvss_score) (D8).&lt;br&gt;• Neo4j Community: no property-existence constraints, so import scripts validate required properties.&lt;br&gt;• Revoked / deprecated ATT&amp;amp;CK objects are not loaded; stale CTID ids are remapped via revoked-by (D2).&lt;br&gt;• Group ↔ CVE is only ever a shared-technique path, never a direct link (D12)." vertex="1" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;">
          <mxGeometry x="900" y="1000" width="1120" height="118" as="geometry" />
        </mxCell>
