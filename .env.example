# Copy to .env and adjust. Never commit .env.
LOG_LEVEL=INFO
DATA_DIR=data

# Neo4j. Use letters and digits only in the password: it is embedded in NEO4J_AUTH.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Optional. Raises the NVD API 2.0 rate limit: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# LLM for the agent (D19): groq (default, free key: https://console.groq.com/keys), anthropic, or ollama
# (local, no key). Leave LLM_MODEL empty for the default: qwen/qwen3.8-27b (groq), claude-haiku-5-5
# (anthropic) or qwen2.5:3b (ollama).
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Native Ollama listens on http://localhost:11434. docker-compose sets http://ollama:11434 for the api container.
OLLAMA_BASE_URL=http://localhost:11434
# Retries on HTTP 429 (rate limited), with exponential backoff.
LLM_MAX_RETRIES=6
