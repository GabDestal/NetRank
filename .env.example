# Copy to .env (cp .env.example .env) and set real values. Never commit .env.

# Neo4j. Used by `make run` on the host; docker compose overrides NEO4J_URI to bolt://neo4j:7687.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# At least 8 characters (Neo4j 5 policy). Letters and digits only: it is embedded in NEO4J_AUTH.
NEO4J_PASSWORD=changeme123
NEO4J_DATABASE=neo4j

# API
LOG_LEVEL=INFO

# Host port of the nginx reverse proxy (the only service exposing the API).
NGINX_PORT=8080
