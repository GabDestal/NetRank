# Copy to .env (cp .env.example .env) and set real values. Never commit .env.

# Neo4j. Used by `make run` on the host; docker compose overrides NEO4J_URI to bolt://neo4j:7687.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# At least 8 characters (Neo4j 5 policy). Letters and digits only: it is embedded in NEO4J_AUTH.
NEO4J_PASSWORD=changeme123
NEO4J_DATABASE=neo4j

# API
LOG_LEVEL=INFO
# Key for POST /api/admin/gds/refresh (header X-API-Key). Generate one, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-to-a-long-random-string
# GDS threads (Community edition max 4). Use 1 for reproducible KNN/Louvain results.
GDS_CONCURRENCY=4
# Minimum matches with serve statistics for a player to get a style vector.
STYLE_MIN_MATCHES=50

# Host port of the nginx reverse proxy (the only service exposing the API).
NGINX_PORT=8080

# Agent (POST /api/agent/ask, make eval). Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_MAX_STEPS=8
