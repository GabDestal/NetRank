# Copy to .env and adjust. Never commit .env.
LOG_LEVEL=INFO
DATA_DIR=data

# Neo4j. Use letters and digits only in the password: it is embedded in NEO4J_AUTH.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Optional. Raises the NVD API 2.0 rate limit: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
